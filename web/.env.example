# Prototype A calls Groq. Without this the A variants fall back to the
# deterministic baseline and label themselves as having done so.
GROQ_API_KEY=
# llama-3.1-8b-instant: the highest free daily ceiling of the Groq models
# (14,400 requests/day) and the lowest latency, which is what a live demo
# and a scored evaluation run both need. Swap for llama-3.3-70b-versatile
# (1,000/day) if a step needs harder reasoning.
GROQ_MODEL=llama-3.1-8b-instant

# NSW Prototype B's OpenCV metrology service.
VISION_URL=http://127.0.0.1:8000
