# Optional. By default the browser calls /api on this server, and
# next.config.ts forwards it to the backend at API_PROXY_TARGET
# (default http://127.0.0.1:8001) — which is what lets a phone on the same
# Wi-Fi use the app. Set this only to point the browser somewhere else.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api
