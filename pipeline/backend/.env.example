# Copy to .env. Every value here has a working default — the backend runs
# with this file absent.

# Optional. Enables the two LLM calls the pipeline budgets per case:
# the pass-2 critic and the free-text intake mapper.
# Without a key both report "unavailable" on screen and the rest of the
# pipeline — measurement, rule engine, gates, tiering — is unaffected.
GROQ_API_KEY=

# Any model on Groq's catalog. Default is openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b
