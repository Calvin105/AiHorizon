# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is git-ignored (see repo .gitignore) so the real key never gets committed.

GEMINI_API_KEY=

# Model id to call via the Gemini API (google-genai SDK).
# You mentioned "3.5 Flash Preview" for the free rate-limited tier -- my
# knowledge cutoff is Jan 2026 so I can't confirm that exact id still exists
# or is spelled that way. Check the current list at
# https://ai.google.dev/gemini-api/docs/models (or in Google AI Studio) and
# put the exact model id here, e.g. gemini-2.5-flash or gemini-3-flash-preview.
GEMINI_MODEL=
